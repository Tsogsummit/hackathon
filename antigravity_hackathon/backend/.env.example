# Хоосон/буруу token → Chimege 403. «Монгол STT-Long» токен нь /transcribe биш /stt-long ашиглана.
CHIMEGE_API_TOKEN=your_token_here
# auto = эхлээд transcribe, 403 бол stt-long | transcribe | stt_long
CHIMEGE_STT_MODE=auto
CHIMEGE_STT_LONG_MAX_WAIT_SECONDS=1800
GEMINI_API_KEY=your_key_here
# Жишээ stable: gemini-2.5-flash (gemini-1.5-flash олон орчинд 404)
GEMINI_MODEL=gemini-2.5-flash
# docker compose up -d дээрх postgres (host дээр 5433, docker-compose.yml)
DATABASE_URL=postgresql://edusmart:edusmart@localhost:5433/edusmartmn
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret

# Хоосон баазад анхны админ (зөвхөн хэрэглэгч 0 үед)
BOOTSTRAP_ADMIN_EMAIL=admin@school.mn
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_NAME=Админ
AUTO_SEED_TEST_DATA=true
MAX_AUDIO_SIZE_MB=50
AUDIO_CHUNK_DURATION_MINUTES=10
CHIMEGE_TIMEOUT_SECONDS=30
