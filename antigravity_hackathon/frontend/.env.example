# Vite (энэ төсөл) — хөгжүүлэлтэд Vite proxy /api → localhost:8000
VITE_API_BASE_URL=/api

# Шууд backend руу заах бол заавал /api төгсгөлтэй байх ёстой (жишээ нь /auth/login биш, /api/auth/login)
# VITE_API_BASE_URL=http://localhost:8000/api

# Create React App-тай нэгэн адил (хэрэв CRA ашиглавал):
# REACT_APP_API_BASE_URL=http://localhost:8000/api

VITE_LESSON_ID=1
VITE_AUTH_TOKEN=

# Бичлэгийн хамгийн их хугацаа (минут)
VITE_MAX_RECORDING_MINUTES=60
